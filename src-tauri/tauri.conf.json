{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XLab Refresh Token",
  "version": "1.0.0",
  "identifier": "vn.xlab.refresh-token",
  "build": {
    "beforeDevCommand": "npm --prefix ../client run dev",
    "beforeBuildCommand": "npm --prefix ../client run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../client/dist"
  },
  "app": {
    "windows": [
      {
        "title": "XLab Refresh Token",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
